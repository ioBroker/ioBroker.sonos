{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "allowJs": false,
        "checkJs": false,
        "noEmit": false,
        "declaration": false,
        "outDir": "./build",
        "rootDir": "./src"
    },
    // tasks.mts is only type-checked, never emitted - node runs it from source
    "include": ["src/**/*.ts"]
}
