{
  "name": "iobroker.sonos",
  "description": "The adapter lets control SONOS from ioBroker",
  "version": "4.2.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "contributors": [
    "bluefox <dogafox@gmail.com>",
    "Jens Maus <mail@jens-maus.de>"
  ],
  "author": "bluefox <dogafox@gmail.com>",
  "homepage": "https://github.com/ioBroker/ioBroker.sonos",
  "keywords": [
    "ioBroker",
    "SONOS"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.sonos"
  },
  "overrides": {
    "sonos-discovery": {
      "html-entities": "1.0.10"
    },
    "@svrooij/sonos": {
      "fast-xml-parser": "3.19.0"
    }
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@svrooij/sonos": "^2.5.0",
    "sonos-discovery": "^1.7.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.1.0",
    "@iobroker/types": "^7.2.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.1",
    "typescript": "~6.0.3"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.sonos/issues"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "img/",
    "widgets/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:widgets && npm run build:web && npm run build:admin && npm run build:devices",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:widgets": "node tasks.js",
    "build:admin": "node tasks.js --admin",
    "build:devices": "node tasks.js --devices",
    "build:web": "node tasks.js --web",
    "build:all": "npm run build:ts && node tasks.js --all",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check:ts": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint -c eslint.config.mjs src && cd src-devices && npm run lint && cd ../src-admin && npm run lint && cd ../src-web && npm run lint",
    "lint:fix": "eslint -c eslint.config.mjs src --fix",
    "prepublishOnly": "npm run build",
    "test": "npm run test:package && npm run test:lib && npm run test:unit",
    "test:package": "mocha test/package --exit",
    "pretest:lib": "npm run build:ts",
    "test:lib": "mocha test/lib.test.js --exit",
    "test:unit": "mocha test/unit --exit",
    "pretest:integration": "npm run build:ts",
    "test:integration": "mocha test/integration --exit",
    "update-packages": "npx -y npm-check-updates -u && cd src-widgets && npx -y npm-check-updates -u && cd ../src-admin && npx -y npm-check-updates -u && cd ../src-devices && npx -y npm-check-updates -u&& cd ../src-web && npx -y npm-check-updates -u",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "translate": "translate-adapter",
    "npm": "npm i && cd src-widgets && npm i && cd ../src-admin && npm i && cd ../src-devices && npm i && cd ../src-web && npm i"
  },
  "license": "MIT"
}
