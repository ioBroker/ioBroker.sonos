{
    "$schema": "https://raw.githubusercontent.com/ioBroker/web-components/main/schemas/manifest.json",
    "manifestVersion": 1,
    "tag": "iob-sonos-rooms",
    "name": {
        "en": "SONOS rooms",
        "de": "SONOS rooms",
        "ru": "SONOS rooms",
        "pt": "SONOS rooms",
        "nl": "SONOS rooms",
        "fr": "SONOS rooms",
        "it": "SONOS rooms",
        "es": "SONOS rooms",
        "pl": "SONOS rooms",
        "uk": "SONOS rooms",
        "zh-cn": "SONOS rooms"
    },
    "description": {
        "en": "Overview and grouping of all SONOS speakers",
        "de": "Übersicht und Gruppierung aller SONOS-Lautsprecher",
        "ru": "Обзор и группировка всех колонок SONOS",
        "pt": "Visão geral e agrupamento de todas as colunas SONOS",
        "nl": "Overzicht en groeperen van alle SONOS-luidsprekers",
