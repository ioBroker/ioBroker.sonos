{
  "type": "tabs",
  "i18n": true,
  "items": {
    "mainTab": {
      "type": "panel",
      "label": "Main settings",
      "items": {
        "webServer": {
          "type": "instance",
          "adapter": "web",
          "label": "Web server",
          "help": "used for TTS",
          "allowDeactivate": true,
          "long": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 3,
          "xl": 3
        },
        "elapsedInterval": {
          "newLine": true,
          "type": "number",
          "min": 500,
          "max": 60000,
          "label": "Update of elapsed time",
          "help": "in milliseconds",
          "xs": 12,
          "sm": 12,
          "md": 4,
          "lg": 3,
          "xl": 3
        },
        "_tooltip_elapsedInterval": {
          "type": "staticText",
          "text": "tooltip_elapsedInterval",
          "style": {
            "marginTop": 21
          },
          "xs": 12,
          "sm": 12,
          "md": 8,
          "lg": 9,
          "xl": 9
        },
        "fadeIn": {
          "newLine": true,
          "type": "number",
          "min": 0,
          "max": 10000,
          "label": "Fade in (text2speech)",
          "help": "in milliseconds",
          "xs": 12,
          "sm": 12,
          "md": 4,
          "lg": 3,
          "xl": 3
        },
        "_tooltip_fadeIn": {
          "type": "staticText",
          "text": "tooltip_fadeIn",
          "style": {
            "marginTop": 21
          },
          "xs": 12,
          "sm": 12,
          "md": 8,
          "lg": 9,
          "xl": 9
        },
        "fadeOut": {
          "newLine": true,
          "type": "number",
          "min": 0,
          "max": 10000,
          "label": "Fade out (text2speech)",
          "help": "in milliseconds",
          "xs": 12,
          "sm": 12,
          "md": 4,
          "lg": 3,
          "xl": 3
        },
        "_tooltip_fadeOut": {
          "type": "staticText",
          "text": "tooltip_fadeOut",
          "style": {
            "marginTop": 21
          },
          "xs": 12,
          "sm": 12,
          "md": 8,
          "lg": 9,
          "xl": 9
        },
        "backend": {
          "newLine": true,
          "type": "select",
          "label": "Sonos library",
          "help": "backend_help",
          "options": [
            {
              "label": "sonos-discovery (default)",
              "value": "discovery"
            },
            {
              "label": "@svrooij/sonos (experimental)",
              "value": "svrooij"
            }
          ],
          "default": "discovery",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 3,
          "xl": 3
        }
      }
    },
    "devicesTab": {
      "type": "panel",
      "label": "SONOS devices",
      "items": {
        "_sendto": {
          "type": "sendTo",
          "variant": "contained",
          "command": "browse",
          "label": "Search",
          "useNative": true,
          "jsonData": "{\"devices\":${JSON.stringify(data.devices)}}",
          "showProcess": true,
          "icon": "search",
          "timeout": 10000,
          "xs": 12,
          "sm": 12,
          "md": 4,
          "lg": 3,
          "xl": 3
        },
        "devices": {
          "newLine": true,
          "type": "table",
          "items": [
            {
              "type": "text",
              "attr": "name",
              "width": "30%",
              "title": "Name",
              "filter": true
            },
            {
              "type": "text",
              "attr": "ip",
              "width": "30%",
              "title": "IP-Address",
              "default": "0.0.0.0"
            },
            {
              "type": "room",
              "attr": "room",
              "width": "30%",
              "title": "Room",
              "allowDeactivate": true
            }
          ],
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    },
    "controlTab": {
      "type": "panel",
      "label": "Control",
      "items": {
        "_control": {
          "type": "custom",
          "i18n": true,
          "url": "custom/customComponents.js",
          "name": "ConfigCustomSonosSet/Components/SonosControlComponent",
          "guiApi": 2,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    }
  }
}
